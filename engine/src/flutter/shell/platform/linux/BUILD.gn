# OLYM Phase-6 Linux HDR: the GTK3 embedder speaks the linux-dmabuf +
# color-management Wayland protocols directly (fl_compositor_hdr.cc), which need
# wayland-client >= 1.20 (wl_proxy_marshal_flags). The pinned bullseye sysroot
# ships wayland 1.18, so we vendor the wayland 1.20.0 client headers + generated
# protocol stubs in wayland_vendor/ — an explicit -I makes them win over the
# sysroot's stale 1.18 copies. We deliberately do NOT link a libwayland at build
# (see the -z,undefs note on flutter_linux_gtk below): the wayland symbols stay
# undefined in libflutter_linux_gtk.so and resolve at RUNTIME from the system
# libwayland-client.so.0 that GTK already loads. So this is a headers-only
# override — no vendored binary. glibc floor is untouched (Linux SDR coverage
# unchanged); HDR just additionally needs wayland >= 1.20 at runtime (gated on
# the compositor advertising wp_color_manager).
config("wayland_vendor") {
  include_dirs = [ "wayland_vendor" ]
}

# OLYM Phase-6 Linux HDR: relax the global -Wl,-z,defs for the embedder .so so
# the wayland-client symbols fl_compositor_hdr.cc references (wl_proxy_marshal_flags
# etc.) may stay undefined at link and resolve at runtime from the system
# libwayland-client.so.0 GTK loads. Applied as an APPENDED config so -z,undefs is
# emitted AFTER the default link config's -z,defs (last -z wins in lld).
config("allow_undefined_symbols") {
  ldflags = [ "-Wl,-z,undefs" ]
}

